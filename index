    function openReport(printAfterOpen){
      if(!allPlannedDatesCovered()){
        setStatus("Completa tutte le giornate generate prima del riepilogo.","warn");
        return;
      }

      const report=buildReportHtml();
      const prodName=document.getElementById("prod-name").value.trim()||"produzione";
      const documentTitle="conteggi_"+cleanFileName(prodName);

      const win=window.open("","_blank");

      if(!win){
        setStatus("Popup bloccato: abilita l'apertura delle finestre per questa app.","warn");
        return;
      }

      win.document.open();
      win.document.write(report);
      win.document.close();
      win.document.title=documentTitle;

      if(printAfterOpen){
        win.addEventListener("load",()=>{
          setTimeout(()=>{
            win.focus();
            win.print();
          },250);
        });
      }

      setStatus(
        printAfterOpen
          ? "Documento pronto per il salvataggio in PDF."
          : "Riepilogo aperto in nuova scheda.",
        "ok"
      );
    }

    document.getElementById("showReportBtn").addEventListener("click",(e)=>{
      pulseBtn(e.currentTarget);
      openReport(false);
    });

    document.getElementById("savePdfBtn").addEventListener("click",(e)=>{
