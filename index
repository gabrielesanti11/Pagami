    function setAnim(key,on){
      const el=document.querySelector('[data-key="'+key+'"]');
      if(!el) return;

      const badge=el.querySelector(".badge-ex");
      const circle=el.querySelector("svg circle");
      if(!badge||!circle) return;

      if(on){
        badge.classList.remove("active");
        circle.style.transition="none";
        circle.style.strokeDashoffset=150;
        void badge.offsetWidth;
        badge.classList.add("active");

        requestAnimationFrame(()=>{
          circle.style.transition="stroke-dashoffset .45s ease-out";
          circle.style.strokeDashoffset=0;
        });
      }else{
        badge.classList.remove("active");
        circle.style.transition="none";
        circle.style.strokeDashoffset=150;
      }
    }

    function normalizeTimeAfterStart(value,start){
      let m=hhmmToMin(value);
      if(m<start) m+=1440;
      return m;
    }

    function buildWorkMinutes(start,end,pstart,pend,hasPause){
      const minutes=[];

      const addInterval=(a,b)=>{
        for(let minute=a;minute<b;minute++){
          minutes.push(minute);
        }
      };

      if(hasPause){
        addInterval(start,pstart);
        addInterval(pend,end);
      }else{
        addInterval(start,end);
      }

      return minutes;
    }

    function isNightMinute(absoluteMinute){
      const minuteOfDay=((absoluteMinute%1440)+1440)%1440;
      return minuteOfDay>=22*60 || minuteOfDay<5*60;
    }

    /*
      Le ore straordinarie vengono classificate in ordine cronologico:
      - prime 2 ore complessive di straordinario = semplice;
      - dalla 3ª ora complessiva = doppio;
      - ciascun minuto viene poi distinto tra diurno e notturno.
    */
    function classifyOvertime(workMinutes,baseMinutes,rounder){
      const result={
        daySimple:0,
        dayDouble:0,
        nightSimple:0,
        nightDouble:0
      };

      const overtimeMinutes=workMinutes.slice(baseMinutes);

      overtimeMinutes.forEach((absoluteMinute,index)=>{
        const simple=index<120;
        const night=isNightMinute(absoluteMinute);

        if(night&&simple) result.nightSimple++;
        else if(night&&!simple) result.nightDouble++;
        else if(!night&&simple) result.daySimple++;
        else result.dayDouble++;
      });

      if(rounder){
        Object.keys(result).forEach(key=>{
          result[key]=Math.floor(result[key]/30)*30;
        });
      }

      return result;
    }

    let lastCalcSnapshot=null;
    const daysByWorker={};
    let plannedDates=[];

    (function init(){
      const d=new Date();
      const t=dateToStr(d);

      document.getElementById("date").value=t;
      document.getElementById("range-start").value=t;
      document.getElementById("range-end").value=t;

      document.getElementById("start").value="08:00";
      document.getElementById("pstart").value="13:00";
