  <script>
    function pulseBtn(btn){
      if(!btn) return;
      btn.classList.remove("clicked");
      void btn.offsetWidth;
      btn.classList.add("clicked");
      setTimeout(()=>btn.classList.remove("clicked"),220);
    }

    function setStatus(msg,type){
      const el=document.getElementById("status-msg");
      el.textContent=msg||"";
      el.classList.remove("warn","ok");
      if(type) el.classList.add(type);
    }

    function strToLocalDate(str){
      const [y,m,d]=str.split("-").map(Number);
      return new Date(y,m-1,d);
    }

    function dateToStr(d){
      const y=d.getFullYear();
      const m=String(d.getMonth()+1).padStart(2,"0");
      const dd=String(d.getDate()).padStart(2,"0");
      return `${y}-${m}-${dd}`;
    }

    function hhmmToMin(s){
      const [h,m]=s.split(":").map(Number);
      return h*60+m;
    }

    function minToHHMM(m){
      const safe=Math.max(0,Math.round(m));
      const h=Math.floor(safe/60);
      const mm=safe%60;
      return h+":"+String(mm).padStart(2,"0");
    }

    function euro(v){
      return "€ "+Number(v||0).toFixed(2).replace(".",",");
    }

    function cleanFileName(value){
      return String(value||"produzione")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g,"")
        .replace(/[^a-zA-Z0-9_-]+/g,"_")
        .replace(/^_+|_+$/g,"")
        .toLowerCase() || "produzione";
    }

    function getItalianFixedHolidays(year){
      return new Set([
        `${year}-01-01`,
        `${year}-01-06`,
        `${year}-04-25`,
        `${year}-05-01`,
        `${year}-06-02`,
        `${year}-08-15`,
        `${year}-11-01`,
        `${year}-12-07`,
        `${year}-12-08`,
        `${year}-12-25`,
        `${year}-12-26`
      ]);
    }

    function getEasterSunday(year){
      const f=Math.floor;
      const a=year%19;
      const b=f(year/100);
      const c=year%100;
      const d=f(b/4);
      const e=b%4;
      const g=f((8*b+13)/25);
      const h=(19*a+b-d-g+15)%30;
      const i=f(c/4);
      const k=c%4;
      const l=(32+2*e+2*i-h-k)%7;
      const m=f((a+11*h+22*l)/451);
      const month=f((h+l-7*m+114)/31);
      const day=((h+l-7*m+114)%31)+1;
      return new Date(year,month-1,day);
    }

    function isFestiveDate(dateStr){
      if(!dateStr) return false;

      const d=strToLocalDate(dateStr);
      const year=d.getFullYear();

      if(d.getDay()===0) return true;
      if(getItalianFixedHolidays(year).has(dateStr)) return true;

      const easter=getEasterSunday(year);
      const easterMonday=new Date(easter);
      easterMonday.setDate(easterMonday.getDate()+1);

      return dateStr===dateToStr(easter) || dateStr===dateToStr(easterMonday);
    }

    const roles={
