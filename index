    function renderPlanTags(){
      const box=document.getElementById("plan-tags");
      box.innerHTML="";

      plannedDates.forEach(d=>{
        const span=document.createElement("span");
        span.className="tag";
        span.textContent=d;
        box.appendChild(span);
      });
    }

    document.getElementById("genRangeBtn").addEventListener("click",(e)=>{
      pulseBtn(e.currentTarget);

      const s=document.getElementById("range-start").value;
      const endDate=document.getElementById("range-end").value;

      if(!s||!endDate){
        setStatus("Seleziona inizio e fine lavoro.","warn");
        return;
      }

      const sd=strToLocalDate(s);
      const ed=strToLocalDate(endDate);

      if(sd>ed){
        setStatus("La data di fine deve essere dopo quella di inizio.","warn");
        return;
      }

      plannedDates=[];
      const cur=new Date(sd);

      while(cur<=ed){
        plannedDates.push(dateToStr(cur));
        cur.setDate(cur.getDate()+1);
      }

      renderPlanTags();
      document.getElementById("date").value=plannedDates[0]||s;
      setStatus("Intervallo generato.","ok");
    });

    const halfEl=document.getElementById("half-day");
    const nineEl=document.getElementById("nine-plus-one");

    halfEl.addEventListener("change",function(){
      const grid=document.getElementById("time-grid");

      if(this.checked){
        nineEl.checked=false;
        grid.classList.add("disabled");
      }else{
        grid.classList.remove("disabled");
      }
    });

    nineEl.addEventListener("change",function(){
      if(this.checked&&halfEl.checked){
        halfEl.checked=false;
        document.getElementById("time-grid").classList.remove("disabled");
      }
    });

    function doCalc(){
      setStatus("");

      const roleId=document.getElementById("role").value;
      const r=roles[roleId];

      const rounder=document.getElementById("rounder").checked;
      const fatturaPercent=Math.max(0,Number(document.getElementById("fattura-percent").value)||0);
      const fattura=fatturaPercent>0;
      const fatturaMultiplier=1+(fatturaPercent/100);
      const ninePlusOne=document.getElementById("nine-plus-one").checked;
      const half=document.getElementById("half-day").checked;
      const latePauseOk=document.getElementById("late-pause-ok").checked;

      const currentDate=document.getElementById("date").value;
      const festive=isFestiveDate(currentDate);

      if(!r){
        setStatus("Tariffe mancanti per il ruolo selezionato.","warn");
        return null;
      }

      [
        "day-simple",
        "day-double",
        "night-simple",
        "night-double",
        "pause-miss",
        "cont",
        "festive"
      ].forEach(k=>setAnim(k,false));

      document.getElementById("ex-fest").textContent=festive?"SI":"NO";
      setAnim("festive",festive);

      /* MEZZA GIORNATA */
      if(half){
        const basePay=r.base/2;
        const subtotal=basePay;
        const festiveSurcharge=festive?subtotal:0;

        const preInvoiceTotal=subtotal+festiveSurcharge;
        const invoiceSurcharge=fattura?preInvoiceTotal*(fatturaPercent/100):0;
        let total=preInvoiceTotal+invoiceSurcharge;

        document.getElementById("ex-simple").textContent="0:00";
        document.getElementById("ex-double").textContent="0:00";
        document.getElementById("ex-night").textContent="0:00";
        document.getElementById("ex-night-double").textContent="0:00";
        document.getElementById("ex-pause").textContent="0:00";
        document.getElementById("ex-cont").textContent="NO";

        document.getElementById("tot-base").textContent=euro(basePay);
        document.getElementById("tot-simple").textContent=euro(0);
        document.getElementById("tot-double").textContent=euro(0);
        document.getElementById("tot-night").textContent=euro(0);
        document.getElementById("tot-fest").textContent=euro(festiveSurcharge);
        document.getElementById("tot-invoice").textContent=euro(invoiceSurcharge);
        document.getElementById("tot-all").textContent=euro(total);

        lastCalcSnapshot={
          prod:document.getElementById("prod-name").value.trim(),
          worker:document.getElementById("worker-name").value.trim()||"Senza nome",
          roleId,
          date:currentDate,

          start:"MEZZA",
          pstart:"MEZZA",
          pend:"MEZZA",
          end:"MEZZA",

          exSimple:"0:00",
          exDouble:"0:00",
          exNightSimple:"0:00",
          exNightDouble:"0:00",
          exPause:"0:00",

          cont:"NO",
          festive,
          ninePlusOne:false,

          baseMoney:basePay,
          simpleMoney:0,
          doubleMoney:0,
          nightMoney:0,
          festiveMoney:festiveSurcharge,
          invoiceMoney:invoiceSurcharge,
          total,

          half:true,
          fattura,
          fatturaPercent
        };

        return lastCalcSnapshot;
      }

      /* ORARI */
      const startVal=document.getElementById("start").value;
      const pstartVal=document.getElementById("pstart").value;
      const pendVal=document.getElementById("pend").value;
      const endVal=document.getElementById("end").value;

      if(!startVal||!endVal){
        setStatus("Inserisci almeno orario di inizio e fine set.","warn");
        return null;
      }

      const start=hhmmToMin(startVal);
      let end=normalizeTimeAfterStart(endVal,start);

      let pstart=pstartVal?normalizeTimeAfterStart(pstartVal,start):start;
      let pend=pendVal?normalizeTimeAfterStart(pendVal,start):pstart;

      if(pend<pstart) pend+=1440;
      if(end<pstart) end+=1440;

      const hasPause=Boolean(
        pstartVal&&
        pendVal&&
        pstart<pend&&
        pstart>=start&&
        pend<=end
      );

      const workMinutes=buildWorkMinutes(start,end,pstart,pend,hasPause);
      const pauseOffset=hasPause?(pstart-start):Infinity;

      const pauseDeadline=(latePauseOk?6:5)*60;
      const pauseLate=hasPause&&pauseOffset>pauseDeadline;

      /*
        Continuato quando:
        - la pausa è assente;
        - oppure la pausa comincia oltre 7 ore dall'inizio.
      */
      const cont=!hasPause||pauseOffset>7*60;

      document.getElementById("ex-cont").textContent=cont?"SI":"NO";
      setAnim("cont",cont);

      const baseMinutes=cont
        ? 7*60
        : (ninePlusOne?9*60:8*60);

      const overtime=classifyOvertime(workMinutes,baseMinutes,rounder);

      /*
        Mancata pausa:
        - pausa assente;
        - oppure pausa oltre la 5ª ora;
        - entro la 6ª solo quando l'apposita condizione speciale è selezionata.
      */
      const missMin=(!hasPause||pauseLate)?60:0;

      document.getElementById("ex-simple").textContent=minToHHMM(overtime.daySimple);
      document.getElementById("ex-double").textContent=minToHHMM(overtime.dayDouble);
      document.getElementById("ex-night").textContent=minToHHMM(overtime.nightSimple);
      document.getElementById("ex-night-double").textContent=minToHHMM(overtime.nightDouble);
      document.getElementById("ex-pause").textContent=missMin?"1:00":"0:00";

      setAnim("day-simple",overtime.daySimple>0);
      setAnim("day-double",overtime.dayDouble>0);
      setAnim("night-simple",overtime.nightSimple>0);
      setAnim("night-double",overtime.nightDouble>0);
      setAnim("pause-miss",missMin>0);

      /*
        La tariffa base notturna viene applicata quando il turno inizia
        dalle 16:00 in poi, come nelle versioni precedenti dell'app.
      */
      const dayIsNight=start>=16*60;

      let basePay=r.base;
      let rateSimple=r.s;
      let rateDouble=r.d;
      let rateNightSimple=r.nightSimple;
      let rateNightDouble=r.nightDouble;

      if(dayIsNight&&r.nightBase){
        basePay=r.nightBase;
        rateSimple=r.nightSimple;
        rateDouble=r.nightDouble;
        rateNightSimple=r.nightSimple;
        rateNightDouble=r.nightDouble;
      }

      const moneySimple=rateSimple*(overtime.daySimple/60);
      const moneyDouble=rateDouble*(overtime.dayDouble/60);
      const moneyNightSimple=rateNightSimple*(overtime.nightSimple/60);
      const moneyNightDouble=rateNightDouble*(overtime.nightDouble/60);
      const moneyMiss=missMin?rateSimple:0;

      /*
        Il festivo al 100% raddoppia l'intero conteggio:
        base + extra + mancata pausa.
      */
      const subtotal=
        basePay+
        moneySimple+
        moneyDouble+
        moneyNightSimple+
        moneyNightDouble+
        moneyMiss;

      const festiveSurcharge=festive?subtotal:0;

      const preInvoiceTotal=subtotal+festiveSurcharge;
      const invoiceSurcharge=fattura?preInvoiceTotal*(fatturaPercent/100):0;
      let total=preInvoiceTotal+invoiceSurcharge;

      document.getElementById("tot-base").textContent=euro(basePay);
      document.getElementById("tot-simple").textContent=euro(moneySimple+moneyMiss);
      document.getElementById("tot-double").textContent=euro(moneyDouble);
      document.getElementById("tot-night").textContent=euro(moneyNightSimple+moneyNightDouble);
      document.getElementById("tot-fest").textContent=euro(festiveSurcharge);
      document.getElementById("tot-invoice").textContent=euro(invoiceSurcharge);
      document.getElementById("tot-all").textContent=euro(total);

      if(pauseLate){
        setStatus("Pausa iniziata oltre il limite previsto: applicata mancata pausa.","warn");
      }

      lastCalcSnapshot={
        prod:document.getElementById("prod-name").value.trim(),
        worker:document.getElementById("worker-name").value.trim()||"Senza nome",
        roleId,
        date:currentDate,

        start:startVal,
        pstart:pstartVal||"-",
        pend:pendVal||"-",
        end:endVal,

        exSimple:minToHHMM(overtime.daySimple),
        exDouble:minToHHMM(overtime.dayDouble),
        exNightSimple:minToHHMM(overtime.nightSimple),
        exNightDouble:minToHHMM(overtime.nightDouble),
        exPause:missMin?"1:00":"0:00",

        cont:cont?"SI":"NO",
        festive,
        ninePlusOne,

        baseMoney:basePay,
        simpleMoney:moneySimple+moneyMiss,
        doubleMoney:moneyDouble,
        nightMoney:moneyNightSimple+moneyNightDouble,
        festiveMoney:festiveSurcharge,
        invoiceMoney:invoiceSurcharge,
        total,

        half:false,
        fattura,
        fatturaPercent
      };

      return lastCalcSnapshot;
    }

    document.getElementById("calcBtn").addEventListener("click",doCalc);

    function nextMissingDate(){
      const saved=new Set();

      Object.values(daysByWorker).forEach(arr=>{
        arr.forEach(row=>saved.add(row.date));
      });

      for(const d of plannedDates){
        if(!saved.has(d)) return d;
      }

      return null;
    }

    document.getElementById("addDayBtn").addEventListener("click",(e)=>{
      pulseBtn(e.currentTarget);

      const snapshot=doCalc();

      if(!snapshot){
        setStatus("Fai prima il calcolo per la giornata corrente.","warn");
        return;
      }

      const worker=snapshot.worker;
      if(!daysByWorker[worker]) daysByWorker[worker]=[];

      const idx=daysByWorker[worker].findIndex(x=>x.date===snapshot.date);

      if(idx!==-1){
        daysByWorker[worker][idx]={...snapshot};
        setStatus("Giornata aggiornata: "+snapshot.date,"ok");
      }else{
        daysByWorker[worker].push({...snapshot});
        setStatus("Giornata aggiunta: "+snapshot.date,"ok");
      }

      const nextDate=nextMissingDate();

      if(nextDate){
        document.getElementById("date").value=nextDate;
      }
    });

    function allPlannedDatesCovered(){
      if(plannedDates.length===0) return true;

      const saved=new Set();

      Object.values(daysByWorker).forEach(arr=>{
        arr.forEach(row=>saved.add(row.date));
      });

      return plannedDates.every(d=>saved.has(d));
    }

    function escapeHtml(value){
      return String(value??"")
        .replaceAll("&","&amp;")
        .replaceAll("<","&lt;")
        .replaceAll(">","&gt;")
        .replaceAll('"',"&quot;")
        .replaceAll("'","&#39;");
